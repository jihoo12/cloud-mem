{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-mem",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-mem",
      "migrations_dir": "migrations"
    }
  ]
}
